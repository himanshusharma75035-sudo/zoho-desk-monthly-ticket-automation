ZOHO_CLIENT_ID=replace_with_zoho_client_id
ZOHO_CLIENT_SECRET=replace_with_zoho_client_secret
ZOHO_REFRESH_TOKEN=replace_with_zoho_refresh_token
ZOHO_ORG_ID=replace_with_zoho_desk_org_id

# India data center defaults are used below. Change these if your Zoho account is in another region.
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_DESK_API_BASE=https://desk.zoho.in/api/v1

TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_telegram_chat_id
